{
  "name": "creatorco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/design-system/check.mjs && tsx src/db/scripts/check.ts",
    "dev": "next dev",
    "db:check": "tsx src/db/scripts/check.ts",
    "jobs:tick": "tsx scripts/jobs-tick.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run ds:check && npm run lint && npm run typecheck && npm run format:check && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/scripts/migrate.ts",
    "db:reference": "tsx src/db/scripts/seed.ts --reference-only",
    "db:seed": "tsx src/db/scripts/seed.ts",
    "db:reset": "tsx src/db/scripts/reset.ts && npm run db:migrate && npm run db:seed",
    "tokens": "tsx src/design/scripts/generate-css.ts && tsx src/design/scripts/generate-json.ts && prettier --write src/app/tokens.css design-system/tokens.json",
    "prebuild": "node scripts/design-system/check.mjs",
    "ds:check": "node scripts/design-system/check.mjs",
    "ds:pin": "node scripts/design-system/pin.mjs",
    "ds:screens": "playwright test --grep @ds",
    "partner:sandbox": "node scripts/partner-sandbox.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
