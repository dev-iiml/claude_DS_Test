# CreatorCo — copy to .env.local (app) and .env (scripts/drizzle). Never commit real values.

# development | test | staging | production
APP_ENV=development
APP_URL=http://localhost:3000

# Any PostgreSQL 15+ database (local, Supabase, Neon, RDS…).
DATABASE_URL=postgres://creatorco:creatorco@localhost:5432/creatorco_dev
# Staging/production: DATABASE_URL is a login user that is a member of `creatorco_app` (rows only, no DDL), and
# migrations run with the schema owner below. Locally both can be the same user. See docs/SECURITY_REVIEW.md.
# DATABASE_MIGRATION_URL=postgres://owner:…@host:5432/creatorco
# Separate database used by integration/E2E tests. It is DROPPED and recreated by the test runner.
DATABASE_URL_TEST=postgres://creatorco:creatorco@localhost:5432/creatorco_test

DATABASE_POOL_MAX=5
# Set to false behind a transaction pooler (e.g. Supabase pooler on port 6543 / PgBouncer).
DATABASE_PREPARE=true

# Absolute session lifetime in hours (default 7 days).
SESSION_TTL_HOURS=168

# Password for fictional demo accounts created by `npm run db:seed` (dev/test only).
SEED_DEMO_PASSWORD=CreatorCo-demo-2026

# Optional: E2E database (recreated on every Playwright run). Defaults to DATABASE_URL_TEST with _e2e suffix.
# DATABASE_URL_E2E=postgres://creatorco:creatorco@localhost:5432/creatorco_e2e

# Scheduled jobs: a cron calls GET /api/internal/cron/tick with "Authorization: Bearer $CRON_SECRET".
# Leave unset locally and run `npm run jobs:tick` instead. Generate with: openssl rand -hex 32
# CRON_SECRET=

# Vendor credentials are referenced from /ops by env var name and must start with INTEGRATION_,
# e.g. INTEGRATION_BUREAU_A_API_KEY=... (never stored in the database).

# Key for PAN fingerprints used in duplicate-identity checks. Required in staging/production; never rotate without
# planning (fingerprints are versioned v1:). Generate with: openssl rand -hex 32
# PAN_FINGERPRINT_SECRET=

# AES-256-GCM key for Account Aggregator line items (narration/counterparty), stored in the fin schema under the AA
# consent's data-life. Required in staging/production. Generate with: openssl rand -base64 32
# FI_DATA_ENCRYPTION_KEY=
# Store LIVE AA line items. Mock/sandbox data is always stored. Keep false until counsel and the partner RE sign off.
FI_LIVE_LINE_ITEM_RETENTION=false
# Root key for partner webhook signing secrets (derived per endpoint, never stored). Required in staging/production.
# Generate with: openssl rand -base64 48. Changing it changes every partner's signing secret.
# PARTNER_WEBHOOK_ROOT_KEY=
# Key for pseudonymous analytics ids (keyed hash of the user id; never the id or contact details). Required in
# staging/production. Changing it starts new pseudonyms (funnels can't join across the change). openssl rand -hex 32
# ANALYTICS_PSEUDONYM_KEY=
# Key for hashed rate-limit subjects (client IP, user id, partner id; raw IPs are never stored). Required in
# staging/production. openssl rand -hex 32
# RATE_LIMIT_KEY=
# Loosens rate limits in development/test only (E2E runs use 50). Ignored in staging/production.
# RATE_LIMIT_MULTIPLIER=1
# Header carrying the client IP, set by your edge proxy (Vercel sets x-forwarded-for and overwrites client values).
# CLIENT_IP_TRUSTED_HOPS: 0 when the edge overwrites the header (Vercel); n when n proxies of yours APPEND to it
# (nginx, load balancers) — the n-th entry from the right is used. Never expose `next start` directly: it keeps a
# client-supplied x-forwarded-for.
# CLIENT_IP_HEADER=x-forwarded-for
# CLIENT_IP_TRUSTED_HOPS=0
# Development/test only: raise the 3-per-30-days credit-check limit for demos against the mock bureau (1–100).
# Ignored in staging/production.
# DEV_BUREAU_CHECKS_PER_30_DAYS=50
# Registered sign-up campaigns (comma-separated slugs, e.g. diwali_2026,meetup_blr). Only these are recorded from
# utm_campaign; any other campaign is recorded as "other" (tags can carry names or numbers).
# ANALYTICS_CAMPAIGNS=
