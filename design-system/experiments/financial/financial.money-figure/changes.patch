+import { describe, expect, it } from "vitest";
+
+import { formatInr, formatInrCompact, formatInrRange } from "@/design/money";
+
+describe("rupee formatting", () => {
+  it("uses Indian digit grouping without paise", () => {
+    expect(formatInr(150000)).toBe("₹1,50,000");
+    expect(formatInr(12345678)).toBe("₹1,23,45,678");
+    expect(formatInr(999.6)).toBe("₹1,000");
+  });
+
+  it("compacts to lakh and crore from one lakh up", () => {
+    expect(formatInrCompact(99999)).toBe("₹99,999");
+    expect(formatInrCompact(150000)).toBe("₹1.5 L");
+    expect(formatInrCompact(20000000)).toBe("₹2 Cr");
+    expect(formatInrCompact(-250000)).toBe("-₹2.5 L");
+  });
+
+  it("formats ranges with an en dash", () => {
+    expect(formatInrRange(150000, 200000)).toBe("₹1,50,000 – ₹2,00,000");
+    expect(formatInrRange(150000, 200000, { compact: true })).toBe("₹1.5 L – ₹2 L");
+  });
+});
