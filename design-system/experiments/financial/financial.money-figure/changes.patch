+/**
+ * Indian-rupee formatting for presentation. Pure (Intl only, no Node/DOM/Next), so native apps
+ * and server code can share it.
+ *
+ * - Full: Indian digit grouping, no paise — ₹1,50,000.
+ * - Compact: lakh and crore — ₹1.5 L, ₹2 Cr (below one lakh the full form is used).
+ * - Range: an en dash between two amounts in the same form — ₹1,50,000 – ₹2,00,000.
+ */
+const full = new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 });
+const short = new Intl.NumberFormat("en-IN", { maximumFractionDigits: 2 });
+
+export const LAKH = 1_00_000;
+export const CRORE = 1_00_00_000;
+
+export function formatInr(amount: number): string {
+  return full.format(amount);
+}
+
+export function formatInrCompact(amount: number): string {
+  const abs = Math.abs(amount);
+  const sign = amount < 0 ? "-" : "";
+  if (abs >= CRORE) return `${sign}₹${short.format(abs / CRORE)} Cr`;
+  if (abs >= LAKH) return `${sign}₹${short.format(abs / LAKH)} L`;
+  return formatInr(amount);
+}
+
+export function formatInrRange(min: number, max: number, { compact = false } = {}): string {
+  const f = compact ? formatInrCompact : formatInr;
+  return `${f(min)} – ${f(max)}`;
+}
