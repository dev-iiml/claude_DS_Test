+import { formatInr, formatInrCompact } from "@/design/money";
+import { cn } from "@/lib/cn";
+
+/**
+ * An amount or a range in rupees, in the financial-trust style: ink colours, tabular figures,
+ * no gold, no tier marks, no celebration. Screen readers hear a range as "… to …".
+ * Gate visibility in the page: creators never see recommendation figures before a
+ * partner-lender review.
+ */
+export function MoneyFigure({
+  amount,
+  max,
+  compact = false,
+  size = "body",
+  label,
+  className,
+}: {
+  amount: number;
+  /** Upper bound — renders a range. */
+  max?: number;
+  /** Lakh/crore form (₹1.5 L). */
+  compact?: boolean;
+  size?: "body" | "title";
+  /** Spoken before the amount, e.g. "Proposed eligibility". */
+  label?: string;
+  className?: string;
+}) {
+  const f = compact ? formatInrCompact : formatInr;
+  const shown = max === undefined ? f(amount) : `${f(amount)} – ${f(max)}`;
+  const spoken = max === undefined ? f(amount) : `${f(amount)} to ${f(max)}`;
+  return (
+    <span
+      data-slot="money"
+      className={cn(
+        "text-ink tabular-nums",
+        size === "title" ? "text-title-1 leading-tight font-bold tracking-tight" : "text-body font-semibold",
+        className,
+      )}
+    >
+      <span aria-hidden="true">{shown}</span>
+      <span className="sr-only">
+        {label ? `${label}: ` : ""}
+        {spoken}
+      </span>
+    </span>
+  );
+}
