diff --git a/tests/unit/typography.test.ts b/tests/unit/typography.test.ts
new file mode 100644
index 0000000..8cdf0a2
--- /dev/null
+++ b/tests/unit/typography.test.ts
@@ -0,0 +1,19 @@
+import { readFileSync } from "node:fs";
+
+import { describe, expect, it } from "vitest";
+
+import { fonts } from "@/design/tokens";
+
+describe("Devanagari pairing", () => {
+  it("the sans stack falls back to system Devanagari faces after Inter", () => {
+    const s = fonts.sans;
+    expect(s.indexOf('"Kohinoor Devanagari"')).toBeGreaterThan(s.indexOf('"Inter Variable"'));
+    expect(s).toContain('"Noto Sans Devanagari"');
+  });
+
+  it("Hindi text is never letter-spaced or forced to capitals", () => {
+    const css = readFileSync("src/app/globals.css", "utf8");
+    expect(css).toMatch(/:lang\(hi\) \{\s*letter-spacing: normal;/);
+    expect(css).toMatch(/:lang\(hi\) \.uppercase \{\s*text-transform: none;/);
+  });
+});
