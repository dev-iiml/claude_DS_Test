     }
   }
 }
+
+/*
+ * Hindi / Devanagari (mark content with lang="hi"). Unlayered on purpose so it wins over
+ * utilities: no letter-spacing (it breaks conjuncts), no forced capitals (Devanagari has no
+ * case — uppercase only spaces it out), and body text gets the taller line Devanagari matras need.
+ */
+:lang(hi) {
+  letter-spacing: normal;
+}
+:lang(hi) .uppercase {
+  text-transform: none;
+}
+:lang(hi) :is(p, li, dd, label, td, blockquote) {
+  line-height: 1.6;
+}
