+/*
+ * 44pt tap target without changing the visual size: an invisible ::before grows the
+ * hit area to at least --touch-target (MIN_TOUCH_TARGET) in both directions, centred.
+ * Taps on it reach the element itself. Don't combine with another ::before on the same
+ * element, and keep 8px or more between neighbouring hit areas.
+ */
+@utility hit-area {
+  position: relative;
+  &::before {
+    content: "";
+    position: absolute;
+    top: min(0px, calc((100% - var(--touch-target)) / 2));
+    bottom: min(0px, calc((100% - var(--touch-target)) / 2));
+    left: min(0px, calc((100% - var(--touch-target)) / 2));
+    right: min(0px, calc((100% - var(--touch-target)) / 2));
+  }
+}
+
 @layer base {
   * {
     @apply border-border;
